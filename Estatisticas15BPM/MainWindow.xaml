<Window x:Class="Estatisticas15BPM.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ESTATÍSTICAS 15ª BPM" Icon="Assets/tco-icon-v2.ico" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="#F7F7F4">
 <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="#0A2540"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGrid"><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E3E8EC"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9FA"/><Setter Property="RowHeight" Value="42"/><Setter Property="CanUserResizeRows" Value="False"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF0F3"/><Setter Property="Foreground" Value="#0A2540"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></Window.Resources>
 <Grid><Grid x:Name="DatabasePanel" Margin="40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="ESTATÍSTICAS 15ª BPM" FontSize="30" FontWeight="Bold" Foreground="#0A2540"/><TextBlock Text="Selecione, crie ou importe o banco de dados" Foreground="DimGray"/></StackPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="DatabaseStatus" FontSize="17" Margin="0,0,0,20"/><WrapPanel><Button Content="Selecionar banco" Click="SelectDatabase_Click"/><Button Content="Criar novo banco" Click="CreateDatabase_Click"/><Button Content="Importar .bkp15" Click="ImportDatabase_Click"/></WrapPanel></StackPanel></Grid>
 <Grid x:Name="LoginPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0A2540"><Grid><TextBlock Text="SISTEMA INSTITUCIONAL" Foreground="White" VerticalAlignment="Center" Margin="28,0"/><Button Content="?" Click="Help_Click" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" FontWeight="Bold" Background="#CAA45A" Foreground="#0A2540"/></Grid></Border><StackPanel Grid.Row="1" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"><Image Source="Assets/15 BPM.png" Height="120" Stretch="Uniform"/><TextBlock Text="ESTATÍSTICAS 15ª BPM" FontSize="27" FontWeight="Bold" Foreground="#0A2540" HorizontalAlignment="Center" Margin="0,15,0,2"/><TextBlock Text="15º BATALHÃO DE ALTO ARAGUAIA" Foreground="#153B60" HorizontalAlignment="Center"/><Border Height="2" Background="#CAA45A" Width="100" Margin="0,22"/><TextBlock Text="RGPM, CPF ou login"/><TextBox x:Name="LoginInput" Height="34" Margin="0,5,0,12"/><TextBlock Text="Senha"/><PasswordBox x:Name="PasswordInput" Height="34" Margin="0,5,0,12" KeyDown="PasswordInput_KeyDown"/><TextBlock x:Name="LoginError" Foreground="#A40000" TextWrapping="Wrap"/><Button Content="ACESSAR O SISTEMA" Click="Login_Click" HorizontalAlignment="Center" Margin="0,15"/></StackPanel></Grid>
 <Grid x:Name="AppPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#0A2540"><StackPanel Margin="16"><Image Source="Assets/15 BPM.png" Height="90" Stretch="Uniform"/><TextBlock Text="ESTATÍSTICAS 15ª BPM" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12"/><Separator Margin="0,8"/><Button Content="DASHBOARD" Click="Nav_Click" Tag="DASHBOARD"/><Button Content="TCO" Click="Nav_Click" Tag="TCO"/><Button Content="CRIMES" Click="Nav_Click" Tag="OUTRAS OCORRÊNCIAS"/><Button Content="ESTATÍSTICAS" Click="Nav_Click" Tag="ESTATÍSTICAS"/><Button x:Name="SettingsButton" Content="CONFIGURAÇÕES" Click="Nav_Click" Tag="CONFIGURAÇÕES"/><Separator Margin="0,12"/><TextBlock x:Name="SignedUser" Foreground="#E8EDF1" TextWrapping="Wrap"/><Button Content="Sair" Click="Logout_Click" Background="Transparent"/></StackPanel></Border><Grid Grid.Column="1" Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="DASHBOARD" FontSize="30" FontWeight="Bold" Foreground="#0A2540"/><Border Height="2" Background="#CAA45A" Width="100" HorizontalAlignment="Left" Margin="0,12,0,25"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageHost"/></ScrollViewer></Grid></Grid>
 </Grid>
</Window>
