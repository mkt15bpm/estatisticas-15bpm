<Window x:Class="Estatisticas15BPM.SummaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Conferir cadastro" Width="680" Height="620" WindowStartupLocation="CenterOwner" Background="#F7F7F4">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="TitleText" FontSize="25" FontWeight="Bold" Foreground="#0A2540"/><Border Height="2" Background="#CAA45A" Width="100" HorizontalAlignment="Left" Margin="0,10,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1"><TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="15" LineHeight="24"/></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="VOLTAR PARA EDIÇÃO" Click="Back_Click" Padding="14,9" Margin="0,0,10,0"/><Button x:Name="FinishButton" Content="FINALIZAR" Click="Finish_Click" Background="#0A2540" Foreground="White" Padding="20,9"/></StackPanel>
 </Grid>
</Window>
